{
  "name": "axeon-map-local-shell",
  "private": true,
  "version": "1.1.0-dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run server:build",
    "typecheck": "tsc -b --pretty false && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node server/dist/index.js",
    "server:bootstrap-admin": "node server/dist/bootstrapAdmin.js",
    "server:create-user": "node server/dist/createLocalAccount.js"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.1"
  }
}
